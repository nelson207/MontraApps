# Copy to .env (every app) or .env.<app> (credit, lawyer, stock, factoring, customer: that app only).
# Never commit real values for secrets; these are public client settings.

# "Sign in with Keycloak" on the login page (Authorization Code + PKCE, public client)
VITE_IDP_ENABLED=false
# https://<keycloak>/realms/<realm>
VITE_IDP_AUTHORITY=
# The POS public client. Register its redirect URI <app origin>/auth/callback and its
# post-logout redirect URI <app origin>/login, for every app origin.
VITE_IDP_CLIENT_ID=
# "openid profile" plus the scope or audience the backend team gives you
VITE_IDP_SCOPE=openid profile
# The button's label
VITE_IDP_LABEL=Sign in with Keycloak

# "Sign in with Windows" (Negotiate: Kerberos/NTLM; internal users with a Windows Accipiens account)
#   off     not offered (default)
#   button  a "Sign in with Windows" button on the login page
#   auto    the login page also tries it once by itself (HTTPS API only). Not after a logout, and
#           an automatic sign-in never uses Remember me. Use on intranet PCs where each person has
#           their own Windows account, not on terminals shared under one Windows account.
VITE_WINDOWS_LOGIN=button
